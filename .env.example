# minty-web - local settings. Copy to .env.local; never commit it.
#
# All three are inlined into the browser bundle and the proxy at BUILD time (next.config.ts `env`,
# read in lib/env.ts), so a change needs `npm run dev` restarted or `npm run build` rerun.
# Defaults are the local stack's ports (Minty/docker/stack, cross-cutting rule 6).

# Petty Cash (the Flask app) - login, the re-handoff (/handoff/minty-web) and "Back to Minty".
PETTY_CASH_URL=http://localhost:8010

# minty-subscription-api - every API call this app makes.
SUBSCRIPTION_API_URL=http://localhost:8000

# minty-payment-request-web - the side menu's Bills, the profile's way back.
PAYMENT_REQUEST_WEB_URL=http://localhost:3020
