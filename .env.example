# minty-web - local settings. Copy to .env.local; never commit it.
#
# All four are NEXT_PUBLIC_*: they are inlined into the browser bundle and the middleware at
# BUILD time (lib/env.ts), so a change needs `npm run dev` restarted or `npm run build` rerun.
# Defaults are the local stack's ports (Minty/docker/stack, cross-cutting rule 6).

# minty-billing-api - every API call this app makes.
NEXT_PUBLIC_BILLING_API_URL=http://localhost:8004

# The Flask app - login, the re-handoff (/handoff/minty-web) and "Back to Minty".
NEXT_PUBLIC_MINTY_URL=http://localhost:5001

# The payment-request app (billing-frontend) - the profile lives there until Part 3.
NEXT_PUBLIC_PAYMENTS_WEB_URL=http://localhost:3000

# The subscription feature switch. ON unless 0 - the opposite default to the backends, so a
# developer's `next dev` keeps the feature reachable; the deployed app is switched off
# explicitly at the cutover alongside minty-billing-api (the backends 404 while dark whatever
# this says; this only keeps the doors out of sight - middleware.ts).
NEXT_PUBLIC_SUBSCRIPTION_ENABLED=1
